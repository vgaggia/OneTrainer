{
    "base_model_name": "meituan-longcat/LongCat-Image-Edit",
    "batch_size": 1,
    "gradient_accumulation_steps": 4,
    "learning_rate": 1e-5,
    "learning_rate_warmup_steps": 100.0,
    "model_type": "LONGCAT_IMAGE_EDIT",
    "output_model_format": "ORIGINAL_TRANSFORMER",
    "resolution": "1024",
    "attention_mechanism": "CUDNN",
    "compile": true,
    "latent_caching": true,
    "custom_conditioning_image": false,
    "text_encoder_sequence_length": 512,
    "transformer": {
        "train": true,
        "weight_dtype": "BFLOAT_16",
        "gradient_checkpointing": true,
        "activation_offloading": false,
        "offload_fraction": 0.0
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "training_method": "FINE_TUNE",
    "vae": {
        "train": false,
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "BFLOAT_16",
    "fallback_train_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "timestep_distribution": "LOGIT_NORMAL",
    "dynamic_timestep_shifting": true,
    "layer_filter": "",
    "layer_filter_preset": "full",
    "quantization": {
        "layer_filter": "transformer_blocks,single_transformer_blocks",
        "layer_filter_preset": "blocks"
    },
    "optimizer": {
        "optimizer": "ADAFACTOR"
    },
    "optimizer_defaults": {
        "ADAFACTOR": {
            "optimizer": "ADAFACTOR",
            "fused_back_pass": true,
            "beta1": null,
            "clip_threshold": 1.0,
            "decay_rate": -0.8,
            "eps": 1e-30,
            "eps2": 0.001,
            "relative_step": false,
            "scale_parameter": false,
            "stochastic_rounding": true,
            "warmup_init": false,
            "weight_decay": 0.01
        }
    }
}
