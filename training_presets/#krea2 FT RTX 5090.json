{
    "base_model_name": "krea/Krea-2-Raw",
    "batch_size": 1,
    "learning_rate": 1e-5,
    "model_type": "KREA_2",
    "resolution": "512",
    "compile": false,
    "gradient_checkpointing": "CPU_OFFLOADED",
    "layer_offload_fraction": 0.65,
    "dynamic_timestep_shifting": true,
    "transformer": {
        "train": true,
        "weight_dtype": "BFLOAT_16"
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "training_method": "FINE_TUNE",
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "dataloader_threads": 1,
    "timestep_distribution": "LOGIT_NORMAL",
    "optimizer": {
        "optimizer": "ADAFACTOR"
    }
}
