{
    "base_model_name": "krea/Krea-2-Raw",
    "batch_size": 1,
    "learning_rate": 0.0001,
    "model_type": "KREA_2",
    "resolution": "1024",
    "compile": false,
    "gradient_checkpointing": "ON",
    "layer_offload_fraction": 0.0,
    "dynamic_timestep_shifting": true,
    "transformer": {
        "train": true,
        "weight_dtype": "FLOAT_8"
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "training_method": "LORA",
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "BFLOAT_16",
    "lora_weight_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "output_model_format": "SAFETENSORS",
    "lora_rank": 16,
    "lora_alpha": 16,
    "layer_filter": "",
    "layer_filter_preset": "full",
    "layer_filter_regex": false,
    "quantization": {
        "layer_filter": "^blocks\\.",
        "layer_filter_preset": "blocks",
        "layer_filter_regex": true
    },
    "dataloader_threads": 2,
    "timestep_distribution": "LOGIT_NORMAL"
}
