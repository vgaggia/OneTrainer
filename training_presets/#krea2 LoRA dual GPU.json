{
    "base_model_name": "krea/Krea-2-Raw",
    "batch_size": 1,
    "learning_rate": 0.0002,
    "model_type": "KREA_2",
    "resolution": "768",
    "compile": false,
    "multi_gpu": true,
    "device_indexes": "0,1",
    "gradient_checkpointing": "CPU_OFFLOADED",
    "layer_offload_fraction": 0.25,
    "dynamic_timestep_shifting": true,
    "transformer": {
        "train": true,
        "weight_dtype": "FLOAT_8"
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "training_method": "LORA",
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "FLOAT_16",
    "fallback_train_dtype": "FLOAT_16",
    "lora_weight_dtype": "FLOAT_16",
    "output_dtype": "FLOAT_16",
    "lora_rank": 16,
    "lora_alpha": 16,
    "layer_filter": "attn,mlp",
    "layer_filter_preset": "attn-mlp",
    "layer_filter_regex": false,
    "dataloader_threads": 1,
    "timestep_distribution": "LOGIT_NORMAL"
}
